# Optional. AWS (Elastic Beanstalk, App Runner, ECS) sets PORT.
# The server listens on 0.0.0.0. Default is 3000.
PORT=3000

# Required when NODE_ENV is production.
# Use a unique random string of at least 24 characters.
# The placeholder below is rejected on purpose.
JWT_SECRET=change-me-in-production

# Optional. Production auth cookies are Secure (HTTPS) unless this is false.
# Leave unset when the public site is served over HTTPS.
# COOKIE_SECURE=false

# Leftover from the Google AI Studio template. Not used by EcoInsight.
# GEMINI_API_KEY=
# APP_URL=
